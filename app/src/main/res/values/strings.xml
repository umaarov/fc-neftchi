    <!-- Club history (long-form content) -->
    <string name="history_section_overview">Neftchi\'ning shonli tarixi</string>
    <string name="history_subsection_soviet_era">Dastlabki sovet davri</string>
    <string name="history_paragraph_soviet_era">"Neftchi" futbol klubiga &lt;b&gt;1962-yilda&lt;/b&gt; Farg\'ona shahrida "Neftyanik" nomi bilan asos solingan. 1962-yildan 1991-yilgacha jamoa Sovet Ittifoqining Ikkinchi ligasida (O\'rta Osiyo divizioni) ishtirok etgan. 1990-yilda klub Ikkinchi liganing "Sharq" konferensiyasida g\'olib chiqib, Sovet Birinchi ligasiga yo\'l oladi. 1991-yilgi mavsumda Birinchi ligada 7-o\'rinni egallashi klubning sovet futboli tarixidagi eng yuqori yutug\'i bo\'lib qoldi.</string>
    <string name="history_subsection_independence_era">Mustaqillik davri (Oltin davr)</string>
    <string name="history_paragraph_independence_era">&lt;b&gt;1992-yildan&lt;/b&gt; boshlab klub O\'zbekiston Oliy Ligasida ishtirok etib kelmoqda. "Paxtakor" va "Navbahor" bilan bir qatorda, "Neftchi" Oliy Liganing barcha mavsumlarida tanaffussiz qatnashgan uch klubdan biridir. 1992-yildan 2001-yilgacha bo\'lgan davr klub tarixidagi "oltin davr" hisoblanadi. Yuriy Sarkisyan boshchiligidagi jamoa bu yillarda mamlakatning eng kuchli klubiga aylanib, ketma-ket chempionliklarni qo\'lga kiritdi.</string>
    <string name="history_section_trophies">Asosiy sovrinlar</string>
    <string name="history_trophy_super_league">O\'zbekiston Superligasi Chempioni (5 marta): 1992, 1993, 1994, 1995, 2001</string>
    <string name="history_trophy_cup">O\'zbekiston Kubogi sohibi (2 marta): 1994, 1996</string>
    <string name="history_trophy_cis_cup">MDH Hamdo\'stlik Kubogi finalchisi: 1994</string>
    <string name="history_section_stadium">Stadion</string>
    <string name="history_paragraph_stadium">"Neftchi" dastlab o\'z uy uchrashuvlarini 1932-yilda qurilgan "Farg\'ona" stadionida o\'tkazgan. 2012-yilda yangi arena qurilishi boshlandi va 2015-yilda &lt;b&gt;20,000&lt;/b&gt; tomoshabinga mo\'ljallangan zamonaviy "Istiqlol" stadioni ochildi. Stadionning ochilish o\'yini 2015-yil 3-aprel kuni O\'zbekiston U-20 va Yangi Zelandiya U-20 jamoalari o\'rtasida bo\'lib o\'tgan.</string>
    <string name="history_section_rivalries">Raqobatlar</string>
    <string name="history_subsection_classico">O\'zbek Klassikosi</string>
    <string name="history_paragraph_classico">O\'zbek futbolida an\'anaviy raqobat "Neftchi" va poytaxtning "Paxtakor" klubi o\'rtasida kechadi. Bu qarama-qarshilik Ispaniyadagi "El Klasiko"ga qiyosan "O\'zbek Klassikosi" nomini olgan.</string>
    <string name="history_subsection_valley_derby">Vodiy derbisi</string>
    <string name="history_paragraph_valley_derby">"Neftchi"ning mahalliy va eng ashaddiy raqiblaridan biri Namanganning "Navbahor" klubidir. Shuningdek, "Andijon" klubi bilan o\'yinlar ham "Vodiy derbisi" maqomiga ega bo\'lib, muxlislar uchun doimo katta qiziqish uyg\'otadi.</string>

