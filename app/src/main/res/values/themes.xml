<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.FCNeftchi" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/neftchi_green_primary</item>
        <item name="colorPrimaryVariant">@color/neftchi_green_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/neftchi_green_light</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="android:colorBackground">@color/background_light</item>
        <item name="bottomAppBarStyle">@style/Widget.App.BottomAppBar</item>
        <item name="materialCardViewStyle">@style/Widget.App.CardView</item>

    </style>

    <style name="Widget.App.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
    </style>


    <style name="Widget.App.BottomAppBar" parent="Widget.MaterialComponents.BottomAppBar">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.BottomAppBar</item>
    </style>

    <style name="ThemeOverlay.App.BottomAppBar" parent="">
        <item name="colorOnPrimary">@color/black</item>
    </style>

    <style name="CustomTabTextStyle" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="fontFamily">@font/montserrat_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="StatLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">start</item>
        <item name="android:textAppearance">?attr/textAppearanceBody2</item>
    </style>

    <style name="StatValue" parent="StatLabel">
        <item name="android:textStyle">bold</item>
        <item name="android:layout_gravity">fill_horizontal</item>
        <item name="android:gravity">end</item>
    </style>

    <style name="StatHeader">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="StatHeader.Small" parent="StatHeader">
        <item name="android:layout_width">36dp</item>
    </style>

    <style name="StatData" parent="StatHeader" />

    <style name="StatData.Small" parent="StatData">
        <item name="android:layout_width">36dp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="StatRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="Widget.App.TabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="tabIndicatorColor">@color/white</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabTextColor">#B3FFFFFF</item> <item name="tabSelectedTextColor">@color/white</item>
        <item name="tabTextAppearance">@style/TextAppearance.App.Tab</item>
    </style>

    <style name="TextAppearance.App.Tab" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
    </style>

</resources>