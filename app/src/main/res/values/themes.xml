<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.FCNeftchi" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/yellow_primary</item>
        <item name="colorPrimaryVariant">@color/yellow_dark</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/yellow_light</item>
        <item name="colorSecondaryVariant">@color/yellow_dark</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="bottomAppBarStyle">@style/Widget.App.BottomAppBar</item>
    </style>

    <style name="Widget.App.BottomAppBar" parent="Widget.MaterialComponents.BottomAppBar">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.BottomAppBar</item>
    </style>

    <style name="ThemeOverlay.App.BottomAppBar" parent="">
        <item name="colorOnPrimary">@color/black</item>
    </style>

    <style name="StatLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">start</item>
        <item name="android:textAppearance">?attr/textAppearanceBody2</item>
    </style>

    <style name="StatValue" parent="StatLabel">
        <item name="android:textStyle">bold</item>
        <item name="android:layout_gravity">fill_horizontal</item>
        <item name="android:gravity">end</item>
    </style>

    <style name="StatHeader">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="StatHeader.Small" parent="StatHeader">
        <item name="android:layout_width">36dp</item>
    </style>

    <style name="StatData" parent="StatHeader" />

    <style name="StatData.Small" parent="StatData">
        <item name="android:layout_width">36dp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="StatRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="CustomTabTextStyle" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="fontFamily">@font/montserrat_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

</resources>