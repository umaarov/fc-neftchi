    <!-- Club history (long-form content) -->
    <string name="history_section_overview">The Glorious History of Neftchi</string>
    <string name="history_subsection_soviet_era">Early Soviet Era</string>
    <string name="history_paragraph_soviet_era">FC Neftchi was founded in &lt;b&gt;1962&lt;/b&gt; in Fergana under the name "Neftyanik". From 1962 to 1991 the club competed in the Soviet Second League (Central Asia division). In 1990 the club won the "East" conference of the Second League and earned promotion to the Soviet First League. Finishing 7th in the 1991 First League season remains the club\'s highest achievement in Soviet football history.</string>
    <string name="history_subsection_independence_era">Independence Era (Golden Age)</string>
    <string name="history_paragraph_independence_era">Since &lt;b&gt;1992&lt;/b&gt; the club has competed in the Uzbekistan Super League. Alongside Pakhtakor and Navbahor, Neftchi is one of only three clubs that have played in every Super League season uninterrupted. The years from 1992 to 2001 are considered the club\'s "golden age". Under the leadership of Yuri Sarkisyan the team became the country\'s strongest club and won consecutive championships.</string>
    <string name="history_section_trophies">Major Trophies</string>
    <string name="history_trophy_super_league">Uzbekistan Super League Champion (5 times): 1992, 1993, 1994, 1995, 2001</string>
    <string name="history_trophy_cup">Uzbekistan Cup Winner (2 times): 1994, 1996</string>
    <string name="history_trophy_cis_cup">CIS Commonwealth Cup Finalist: 1994</string>
    <string name="history_section_stadium">Stadium</string>
    <string name="history_paragraph_stadium">Neftchi originally played its home matches at Fergana Stadium, built in 1932. Construction of a new arena began in 2012, and in 2015 the modern Istiqlol Stadium with a capacity of &lt;b&gt;20,000&lt;/b&gt; spectators was opened. The opening match was played on 3 April 2015 between the Uzbekistan U-20 and New Zealand U-20 national teams.</string>
    <string name="history_section_rivalries">Rivalries</string>
    <string name="history_subsection_classico">Uzbek Clasico</string>
    <string name="history_paragraph_classico">The traditional rivalry in Uzbek football is between Neftchi and Pakhtakor of the capital. By analogy with Spain\'s "El Clasico", this matchup is known as the "Uzbek Clasico".</string>
    <string name="history_subsection_valley_derby">Valley Derby</string>
    <string name="history_paragraph_valley_derby">Neftchi\'s most fierce local rival is Navbahor of Namangan. Matches against Andijan also carry the "Valley Derby" status and always draw great interest from fans.</string>

