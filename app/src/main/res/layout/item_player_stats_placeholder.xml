<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_background"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <View
        android:id="@+id/player_image_placeholder"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@color/placeholder_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/player_name_placeholder"
        android:layout_width="120dp"
        android:layout_height="18dp"
        android:layout_marginStart="12dp"
        android:background="@color/placeholder_bg"
        app:layout_constraintBottom_toTopOf="@id/player_number_placeholder"
        app:layout_constraintStart_toEndOf="@id/player_image_placeholder"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <View
        android:id="@+id/player_number_placeholder"
        android:layout_width="80dp"
        android:layout_height="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:background="@color/placeholder_bg"
        app:layout_constraintStart_toEndOf="@id/player_image_placeholder"
        app:layout_constraintTop_toBottomOf="@id/player_name_placeholder" />


    <LinearLayout
        android:id="@+id/stats_container_placeholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="32dp"
            android:layout_height="16dp"
            android:background="@color/placeholder_bg" />

        <View
            android:layout_width="32dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:background="@color/placeholder_bg" />

        <View
            android:layout_width="32dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:background="@color/placeholder_bg" />

        <View
            android:layout_width="32dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:background="@color/placeholder_bg" />

        <View
            android:layout_width="32dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:background="@color/placeholder_bg" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>