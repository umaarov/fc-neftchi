<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp">

    <View
        android:id="@+id/competition_placeholder"
        android:layout_width="120dp"
        android:layout_height="14dp"
        android:background="@color/placeholder_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/date_placeholder"
        android:layout_width="100dp"
        android:layout_height="14dp"
        android:layout_marginTop="2dp"
        android:background="@color/placeholder_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/competition_placeholder" />

    <View
        android:id="@+id/home_name_placeholder"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@color/placeholder_bg"
        app:layout_constraintEnd_toStartOf="@id/time_placeholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/date_placeholder" />

    <View
        android:id="@+id/home_logo_placeholder"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@color/placeholder_bg"
        app:layout_constraintEnd_toEndOf="@id/home_name_placeholder"
        app:layout_constraintStart_toStartOf="@id/home_name_placeholder"
        app:layout_constraintTop_toBottomOf="@id/home_name_placeholder" />

    <View
        android:id="@+id/time_placeholder"
        android:layout_width="80dp"
        android:layout_height="40dp"
        android:background="@color/placeholder_bg"
        app:layout_constraintBottom_toBottomOf="@id/home_logo_placeholder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/home_logo_placeholder" />

    <View
        android:id="@+id/away_name_placeholder"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_marginStart="16dp"
        android:background="@color/placeholder_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/time_placeholder"
        app:layout_constraintTop_toTopOf="@id/home_name_placeholder" />

    <View
        android:id="@+id/away_logo_placeholder"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@color/placeholder_bg"
        app:layout_constraintEnd_toEndOf="@id/away_name_placeholder"
        app:layout_constraintStart_toStartOf="@id/away_name_placeholder"
        app:layout_constraintTop_toBottomOf="@id/away_name_placeholder" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/home_logo_placeholder" />

</androidx.constraintlayout.widget.ConstraintLayout>