<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="@string/match_section_statistics"
        android:textAppearance="?attr/textAppearanceHeadline6"
        android:textStyle="bold" />

    <LinearLayout style="@style/StatRow">

        <TextView
            style="@style/StatLabel"
            android:text="@string/match_stat_shots" />

        <TextView
            android:id="@+id/stat_shots"
            style="@style/StatValue"
            tools:text="12 - 8" />
    </LinearLayout>

    <LinearLayout style="@style/StatRow">

        <TextView
            style="@style/StatLabel"
            android:text="@string/match_stat_shots_on_target" />

        <TextView
            android:id="@+id/stat_shots_on_target"
            style="@style/StatValue"
            tools:text="5 - 2" />
    </LinearLayout>

    <LinearLayout style="@style/StatRow">

        <TextView
            style="@style/StatLabel"
            android:text="@string/match_stat_corners" />

        <TextView
            android:id="@+id/stat_corners"
            style="@style/StatValue"
            tools:text="6 - 3" />
    </LinearLayout>

    <LinearLayout style="@style/StatRow">

        <TextView
            style="@style/StatLabel"
            android:text="@string/match_stat_offsides" />

        <TextView
            android:id="@+id/stat_offsides"
            style="@style/StatValue"
            tools:text="1 - 4" />
    </LinearLayout>

    <LinearLayout style="@style/StatRow">

        <TextView
            style="@style/StatLabel"
            android:text="@string/match_stat_fouls" />

        <TextView
            android:id="@+id/stat_fouls"
            style="@style/StatValue"
            tools:text="10 - 15" />
    </LinearLayout>

    <LinearLayout style="@style/StatRow">

        <TextView
            style="@style/StatLabel"
            android:text="@string/match_stat_yellow_cards" />

        <TextView
            android:id="@+id/stat_yellow_cards"
            style="@style/StatValue"
            tools:text="2 - 3" />
    </LinearLayout>
</LinearLayout>