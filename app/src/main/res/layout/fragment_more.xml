<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/more_page_background"
    android:fillViewport="true"
    tools:context=".ui.more.MoreFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="72dp"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginBottom="32dp"
            android:src="@drawable/splash_icon_v3_playstore"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/team_button"
            style="@style/Widget.App.MoreMenuItem"
            android:text="Jamoa va xodimlar" />

        <TextView
            android:id="@+id/statistics_button"
            style="@style/Widget.App.MoreMenuItem"
            android:text="Statistika" />

        <TextView
            android:id="@+id/club_history_button"
            style="@style/Widget.App.MoreMenuItem"
            android:text="Klub tarixi" />

        <TextView
            android:id="@+id/stadium_button"
            style="@style/Widget.App.MoreMenuItem"
            android:text="Stadion" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="48dp"/>

        <TextView
            android:id="@+id/settings_button"
            style="@style/Widget.App.MoreMenuItem.Secondary"
            android:text="Sozlamalar" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="@font/montserrat_regular"
            android:text="Ijtimoiy tarmoqlar"
            android:textColor="#B3FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/telegram_button"
                style="@style/Widget.App.SocialIcon"
                android:src="@drawable/ic_telegram" />

            <ImageView
                android:id="@+id/instagram_button"
                style="@style/Widget.App.SocialIcon"
                android:src="@drawable/ic_instagram" />

            <ImageView
                android:id="@+id/youtube_button"
                style="@style/Widget.App.SocialIcon"
                android:src="@drawable/ic_youtube" />

            <ImageView
                android:id="@+id/facebook_button"
                style="@style/Widget.App.SocialIcon"
                android:src="@drawable/ic_facebook" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>