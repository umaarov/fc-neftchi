<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    android:layout_margin="8dp">

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="2"
        android:padding="16dp">

        <TextView android:text="Matches" style="@style/StatLabel" />
        <TextView android:id="@+id/stat_matches" tools:text="15" style="@style/StatValue" />
        <TextView android:text="Wins" style="@style/StatLabel" />
        <TextView android:id="@+id/stat_wins" tools:text="8" style="@style/StatValue" />
        <TextView android:text="Draws" style="@style/StatLabel" />
        <TextView android:id="@+id/stat_draws" tools:text="6" style="@style/StatValue" />
        <TextView android:text="Losses" style="@style/StatLabel" />
        <TextView android:id="@+id/stat_losses" tools:text="1" style="@style/StatValue" />
        <TextView android:text="Goals Scored" style="@style/StatLabel" />
        <TextView android:id="@+id/stat_goals_scored" tools:text="25" style="@style/StatValue" />
        <TextView android:text="Goals Conceded" style="@style/StatLabel" />
        <TextView android:id="@+id/stat_goals_conceded" tools:text="13" style="@style/StatValue" />
    </GridLayout>
</com.google.android.material.card.MaterialCardView>
