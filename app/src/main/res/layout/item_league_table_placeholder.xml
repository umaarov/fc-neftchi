<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:paddingVertical="12dp">

    <View
        android:id="@+id/position_placeholder"
        android:layout_width="24dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:background="@color/placeholder_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/logo_placeholder"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:background="@color/placeholder_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/position_placeholder"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/name_placeholder"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@color/placeholder_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/stats_container_placeholder"
        app:layout_constraintStart_toEndOf="@id/logo_placeholder"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/stats_container_placeholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="8dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="32dp"
            android:layout_height="18dp"
            android:background="@color/placeholder_bg" />

        <View
            android:layout_width="32dp"
            android:layout_height="18dp"
            android:background="@color/placeholder_bg" />

        <View
            android:layout_width="32dp"
            android:layout_height="18dp"
            android:background="@color/placeholder_bg" />

        <View
            android:layout_width="32dp"
            android:layout_height="18dp"
            android:background="@color/placeholder_bg" />

        <View
            android:layout_width="32dp"
            android:layout_height="18dp"
            android:background="@color/placeholder_bg" />

        <View
            android:layout_width="32dp"
            android:layout_height="18dp"
            android:background="@color/placeholder_bg" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>