<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="uz.umarov.fcneftchi.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_newsArticleFragment"
            app:destination="@id/newsArticleFragment" />
        <action
            android:id="@+id/action_homeFragment_to_leagueTableFragment"
            app:destination="@id/leagueTableFragment" />
        <action
            android:id="@+id/action_homeFragment_to_matchDetailFragment"
            app:destination="@id/matchDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/matchesFragment"
        android:name="uz.umarov.fcneftchi.ui.matches.MatchesFragment"
        android:label="Matches"
        tools:layout="@layout/fragment_matches">
        <action
            android:id="@+id/action_matchesFragment_to_matchDetailFragment"
            app:destination="@id/matchDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/matchDetailFragment"
        android:name="uz.umarov.fcneftchi.ui.match_detail.MatchDetailFragment"
        android:label="Match Detail">
        <argument
            android:name="gameId"
            app:argType="integer" />
    </fragment>
    <fragment
        android:id="@+id/newsFragment"
        android:name="uz.umarov.fcneftchi.ui.news.NewsFragment"
        android:label="@string/title_news"
        tools:layout="@layout/fragment_news">
        <action
            android:id="@+id/action_newsFragment_to_newsArticleFragment"
            app:destination="@id/newsArticleFragment" />
    </fragment>

    <fragment
        android:id="@+id/newsArticleFragment"
        android:name="uz.umarov.fcneftchi.ui.news.NewsArticleFragment"
        android:label="Article"
        tools:layout="@layout/fragment_news_article">
        <argument
            android:name="articleUrl"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/teamFragment"
        android:name="uz.umarov.fcneftchi.ui.team.TeamFragment"
        android:label="@string/title_team"
        tools:layout="@layout/fragment_team">
        <action
            android:id="@+id/action_teamFragment_to_playerProfileFragment"
            app:destination="@id/playerProfileFragment" />
    </fragment>
    <fragment
        android:id="@+id/moreFragment"
        android:name="uz.umarov.fcneftchi.ui.more.MoreFragment"
        android:label="More Options"
        tools:layout="@layout/fragment_more">
        <action
            android:id="@+id/action_moreFragment_to_teamFragment"
            app:destination="@id/teamFragment" />
        <action
            android:id="@+id/action_moreFragment_to_statisticsFragment"
            app:destination="@id/statisticsFragment" />
        <action
            android:id="@+id/action_moreFragment_to_clubHistoryFragment"
            app:destination="@id/clubHistoryFragment" />

        <action
            android:id="@+id/action_moreFragment_to_stadiumFragment"
            app:destination="@id/stadiumFragment" />

        <action
            android:id="@+id/action_moreFragment_to_socialsFragment"
            app:destination="@id/socialsFragment" />

        <action
            android:id="@+id/action_moreFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="uz.umarov.fcneftchi.ui.settings.SettingsFragment"
        android:label="@string/title_settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/socialsFragment"
        android:name="uz.umarov.fcneftchi.ui.socials.SocialsFragment"
        android:label="@string/title_socials"
        tools:layout="@layout/fragment_socials" />

    <fragment
        android:id="@+id/clubHistoryFragment"
        android:name="uz.umarov.fcneftchi.ui.history.ClubHistoryFragment"
        android:label="@string/title_club_history"
        tools:layout="@layout/fragment_club_history" />

    <fragment
        android:id="@+id/stadiumFragment"
        android:name="uz.umarov.fcneftchi.ui.stadium.StadiumFragment"
        android:label="@string/title_stadium"
        tools:layout="@layout/fragment_stadium" />

    <fragment
        android:id="@+id/leagueTableFragment"
        android:name="uz.umarov.fcneftchi.ui.table.LeagueTableFragment"
        android:label="@string/title_league_table"
        tools:layout="@layout/fragment_league_table" />

    <fragment
        android:id="@+id/videosFragment"
        android:name="uz.umarov.fcneftchi.ui.videos.VideosFragment"
        android:label="@string/title_videos"
        tools:layout="@layout/fragment_videos" />

    <fragment
        android:id="@+id/statisticsFragment"
        android:name="uz.umarov.fcneftchi.ui.stats.StatisticsFragment"
        android:label="@string/title_statistics"
        tools:layout="@layout/fragment_statistics" />

    <fragment
        android:id="@+id/playerProfileFragment"
        android:name="uz.umarov.fcneftchi.ui.player.PlayerProfileFragment"
        android:label="Player Profile"
        tools:layout="@layout/fragment_player_profile">
        <argument
            android:name="playerId"
            app:argType="integer" />
    </fragment>
</navigation>
